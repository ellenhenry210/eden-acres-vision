# Copy to .env.local for development. NEVER commit real values.
# In production, set these in Vercel -> Project -> Settings -> Environment Variables.
# Anything missing simply shows "Coming soon" on the site.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database, sign-in, file storage) -------------------------
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ------------------------------------------------------------
# Keep "false" until KYC is approved and a test payment has been settled end to end.
PAYMENTS_LIVE=false
# Paystack -> Settings -> API Keys & Webhooks (use sk_test_ first)
PAYSTACK_SECRET_KEY=
# Flutterwave -> Settings -> API Keys
FLUTTERWAVE_SECRET_KEY=
# Flutterwave -> Settings -> Webhooks -> "Secret hash" (you invent it; long + random)
FLUTTERWAVE_WEBHOOK_HASH=
# Company account for direct transfers (horse shares, investments, large orders)
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_NAME=

# --- Product verification -----------------------------------------------
# Long random secret used to hash scratch PINs. Changing it invalidates every printed PIN.
PIN_PEPPER=

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Eden Acres <hello@edenacres.ng>"

# --- Ask Eden assistant (Anthropic API) -----------------------------------
ANTHROPIC_API_KEY=
